# Server-only connection to the separately deployed Central RBAC service.
CENTRAL_RBAC_URL=https://central-auth-pe9z.onrender.com
CENTRAL_RBAC_PROJECT_API_KEY=replace-with-the-mosaic-project-key

# These public capability switches must mirror the Central RBAC deployment.
# Keep mobile OTP disabled until an SMS provider is configured there.
MOSAIC_EMAIL_VERIFICATION_ENABLED=true
MOSAIC_MOBILE_OTP_ENABLED=false

# Supplied by CI/deployment. Falls back to "development" locally.
MOSAIC_VERSION=development
